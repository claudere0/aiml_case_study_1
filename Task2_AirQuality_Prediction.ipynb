   "id": "193f7b42",
   "metadata": {},
   "source": [
    "# Task 2: Прогнозирование качества воздуха (PM2.5) в г. Павлодар\n",
    "Обучим модель предсказывать уровень PM2.5 на следующий день."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e902f2d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
    "import os\n",
    "\n",
    "# Загрузим обработанные дневные данные из папки\n",
    "data_dir = 'data'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "81632f91",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Быстрая сборка дневных PM2.5\n",
    "pm25_path = os.path.join(data_dir, 'pm2_5.csv')\n",
    "df = pd.read_csv(pm25_path)\n",
    "df = df[df['city'].str.contains('Pavlodar', case=False, na=False)]\n",
    "df['datetime_utc'] = pd.to_datetime(df["datetime_utc"], utc=True)\n",
    "df_daily = df.set_index('datetime_utc').resample('D')['value_ugm3'].mean().to_frame(name='pm2_5')\n",
    "df_daily = df_daily.dropna()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "82d3075f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Подготовка признаков (Features): используем лаги (предыдущие дни)\n",
    "df_daily['pm2_5_lag1'] = df_daily['pm2_5'].shift(1)\n",
    "df_daily['pm2_5_lag2'] = df_daily['pm2_5'].shift(2)\n",
    "df_daily = df_daily.dropna()\n",
    "\n",
    "X = df_daily[['pm2_5_lag1', 'pm2_5_lag2']]\n",
    "y = df_daily['pm2_5']\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, shuffle=False)\n",
    "print(f\"Тренировочный набор: {len(X_train)} дней, Тестовый: {len(X_test)} дней\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "af836703",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Обучение модели\n",
    "model = LinearRegression()\n",
    "model.fit(X_train, y_train)\n",
    "y_pred = model.predict(X_test)\n",
    "\n",
    "mae = mean_absolute_error(y_test, y_pred)\n",
    "print(f\"Mean Absolute Error (MAE): {mae:.2f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a3e10e5c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Визуализация предсказаний\n",
    "plt.figure(figsize=(12, 5))\n",
    "plt.plot(y_test.index, y_test, label='Фактические значения', color='blue')\n",
    "plt.plot(y_test.index, y_pred, label='Предсказание модели', color='red', linestyle='--')\n",
    "plt.title('Прогноз PM2.5 (Линейная регрессия с лагами)')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
 ],
