   "source": [
    "# Сводная таблица по дням\n",
    "df_pivot = df.pivot_table(index='datetime_utc', columns='pollutant', values='value_ugm3', aggfunc='mean')\n",
    "df_daily = df_pivot.resample('D').mean()\n",
    "df_daily.head()"
   ]
  },
